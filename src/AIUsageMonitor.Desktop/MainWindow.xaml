<Window
    x:Class="AIUsageMonitor.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:AIUsageMonitor.Desktop.ViewModels"
    xmlns:converters="clr-namespace:AIUsageMonitor.Desktop.Converters"
    Title="AI Project Orchestrator"
    Icon="/Assets/apo-icon.ico"
    Width="1180"
    Height="760"
    MinWidth="860"
    MinHeight="580"
    Background="{StaticResource BrandDeepNavyBrush}"
    Foreground="{StaticResource BrandTextBrush}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

        <Style x:Key="WorkspaceNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavigationItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrandSurfaceRaisedBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <ScrollViewer Padding="28" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="26">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="APO / OVERVIEW" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="A clear starting point for orchestrated work." Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource DisplayTitleStyle}" />
                                <TextBlock Text="{Binding ShellStatusText}" Margin="0,16,20,0" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                <Border Margin="0,20,0,0" HorizontalAlignment="Left" Style="{StaticResource StatusChipStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource BrandSuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPersistenceAvailable}" Value="False">
                                                            <Setter Property="Fill" Value="{StaticResource BrandWarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding PersistenceStateText}" Margin="8,0,0,0" Foreground="{StaticResource BrandTextBrush}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Border Grid.Column="1" Width="220" Height="220" Margin="20,0,0,0" Padding="8" HorizontalAlignment="Right" Background="{StaticResource BrandSoftGlowBrush}" CornerRadius="18">
                                <Image Source="/Assets/Logo.png" Stretch="Uniform" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="LOCAL-FIRST" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="Persistence" Margin="0,9,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="{Binding PersistenceText}" Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="TRUTHFUL STATE" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="Provider connections" Margin="0,9,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="Open AI Capacity to inspect detected, configured, and unavailable provider states." Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="QUALITY GATE" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="Execution runtime" Margin="0,9,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="Planned. Review, validation, and approval remain explicit product boundaries." Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Margin="0,18,0,0" Style="{StaticResource CardStyle}" Background="{StaticResource BrandNavyBlueBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="4" Background="{StaticResource BrandAccentGradientBrush}" CornerRadius="2" />
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="PRODUCT PROMISE" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="Quality before quota. Evidence before confidence." Margin="0,8,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="APO is being built as a local-first Windows engineering tool: readable at a glance, explicit about uncertainty, and careful about every handoff." Margin="0,9,0,0" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AiCapacityViewModel}">
            <ScrollViewer Padding="28" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="AI CAPACITY" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="Provider connections, usage and remaining capacity" Margin="0,8,0,0" Style="{StaticResource DisplayTitleStyle}" FontSize="27" />
                            <TextBlock Text="Five approved provider surfaces, with unknown values kept explicit." Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RefreshStateText}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding LastRefreshText}" HorizontalAlignment="Right" Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <Button Content="Refresh all" Command="{Binding RefreshAllCommand}" AutomationProperties.Name="Refresh all AI providers" Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl Margin="0,22,0,0" ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,16,16" Style="{StaticResource CardStyle}" MinHeight="240">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SectionHeadingStyle}" />
                                                <TextBlock Text="{Binding Code}" Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource StatusChipStyle}" Padding="9,5">
                                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrandTextBrush}" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding StatusDetail}" Margin="0,13,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />

                                        <StackPanel Grid.Row="2" Margin="0,14,0,14">
                                            <StackPanel Visibility="{Binding AccountDisplayName, Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBlock Text="ACCOUNT" Style="{StaticResource EyebrowTextStyle}" />
                                                <TextBlock Text="{Binding AccountDisplayName}" Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding SubscriptionText, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,9,0,0">
                                                <TextBlock Text="SUBSCRIPTION" Style="{StaticResource EyebrowTextStyle}" />
                                                <TextBlock Text="{Binding SubscriptionText}" Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding QuotaWindows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,7,0,0" Padding="10" Background="{StaticResource BrandNavyBlueBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1" CornerRadius="9">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource BrandTextBrush}" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding RemainingText}" Foreground="{StaticResource BrandTealBrush}" FontWeight="SemiBold" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding UsageText}" Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" />
                                                                <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Height="5" Margin="0,8,0,0" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <TextBlock Text="{Binding ResetText}" Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}" />
                                                                <TextBlock Text="{Binding SourceText}" Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding CredentialStateText}" Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{Binding LastSuccessfulRefreshText}" Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Refresh" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh provider" Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button Content="Connect / edit" Command="{Binding EditCommand}" AutomationProperties.Name="Connect or edit provider" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Visibility="{Binding CanEditConnection, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
            <DataTemplate.Resources>
                <Style x:Key="ProjectInputTextBoxStyle" TargetType="TextBox">
                    <Setter Property="Background" Value="{StaticResource BrandNavyBlueBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource BrandTextBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Padding" Value="9,7" />
                    <Setter Property="FontFamily" Value="{StaticResource BrandBodyFontFamily}" />
                    <Setter Property="FontSize" Value="13" />
                </Style>
                <Style x:Key="ProjectInputComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource BrandComboBoxStyle}" />

                <Style x:Key="ProjectRegistryListBoxStyle" TargetType="ListBox">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBox">
                                <Border Background="Transparent" BorderThickness="0">
                                    <ScrollViewer
                                        Focusable="False"
                                        VerticalScrollBarVisibility="{Binding Path=(ScrollViewer.VerticalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}"
                                        HorizontalScrollBarVisibility="{Binding Path=(ScrollViewer.HorizontalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="ProjectFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource EyebrowTextStyle}">
                    <Setter Property="Foreground" Value="{StaticResource BrandMutedTextBrush}" />
                    <Setter Property="Margin" Value="0,0,0,5" />
                </Style>
            </DataTemplate.Resources>

            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PROJECTS" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="Registered workspaces and project lifecycle" Margin="0,8,0,0" Style="{StaticResource DisplayTitleStyle}" FontSize="27" />
                        <TextBlock Text="Keep project metadata visible, isolated, and ready for the next approved step." Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh projects" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="New project" Command="{Binding NewProjectCommand}" AutomationProperties.Name="New project" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,22,0,0">
                    <Grid Visibility="{Binding ShowLoadingState, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CardStyle}" Padding="24" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="LOADING REGISTRY" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="Loading registered projects…" Margin="0,9,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="The workspace remains responsive while local project metadata is read." Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding ShowStorageUnavailableState, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CardStyle}" Padding="24" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="STORAGE UNAVAILABLE" Style="{StaticResource EyebrowTextStyle}" Foreground="{StaticResource BrandWarningBrush}" />
                                <TextBlock Text="Project storage is unavailable." Margin="0,9,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="Projects remain read-only until LocalAppData storage is available. No alternate registry is being used." Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding ShowLoadErrorState, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CardStyle}" Padding="24" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="REGISTRY READ FAILED" Style="{StaticResource EyebrowTextStyle}" Foreground="{StaticResource BrandWarningBrush}" />
                                <TextBlock Text="Projects could not be loaded." Margin="0,9,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="Retry the local registry read. Existing editor input, if any, is not discarded." Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                <Button Content="Retry" Command="{Binding RefreshCommand}" AutomationProperties.Name="Retry loading projects" Margin="0,18,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding ShowRegistrySurface, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*" MinWidth="200" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.1*" MinWidth="295" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="REGISTRY" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="Projects" Margin="0,5,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Projects.Count, StringFormat={}{0} total}" VerticalAlignment="Bottom" Style="{StaticResource CaptionTextStyle}" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBox Grid.Row="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRegistryInteractionEnabled}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Search projects" ToolTip="Search by project name or local path" />
                                    <ComboBox Grid.Row="1" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}" IsEnabled="{Binding IsRegistryInteractionEnabled}" Style="{StaticResource ProjectInputComboBoxStyle}" AutomationProperties.Name="Filter projects by status" Margin="0,8,0,0" />

                                    <Grid Grid.Row="2" Margin="0,14,0,0">
                                        <StackPanel Visibility="{Binding ShowEmptyRegistryState, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="NO PROJECTS YET" Style="{StaticResource EyebrowTextStyle}" />
                                            <TextBlock Text="No projects registered yet." Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource SectionHeadingStyle}" />
                                            <TextBlock Text="Register a workspace to make its lifecycle and governance metadata visible here." Margin="0,7,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                            <Button Content="New project" Command="{Binding NewProjectCommand}" AutomationProperties.Name="New project from empty state" Margin="0,16,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" />
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding ShowNoMatchState, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="NO MATCHES" Style="{StaticResource EyebrowTextStyle}" />
                                            <TextBlock Text="No projects match this filter." Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource SectionHeadingStyle}" />
                                            <TextBlock Text="Try another search or choose All in the status filter." Margin="0,7,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <ListBox Grid.Row="3" ItemsSource="{Binding FilteredProjects}" SelectedItem="{Binding SelectedProjectCard, Mode=TwoWay}" IsEnabled="{Binding IsRegistryInteractionEnabled}" Style="{StaticResource ProjectRegistryListBoxStyle}" Margin="0,14,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Registered projects">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,0,0,9" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="ProjectCardBorder" Background="{StaticResource BrandNavyBlueBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="ProjectCardBorder" Property="Background" Value="{StaticResource BrandSurfaceRaisedBrush}" />
                                                                    <Setter TargetName="ProjectCardBorder" Property="BorderBrush" Value="{StaticResource BrandCyanBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                    <Setter TargetName="ProjectCardBorder" Property="BorderBrush" Value="{StaticResource BrandSoftGlowBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Style="{StaticResource SectionHeadingStyle}" />
                                                        <Border Grid.Column="1" Style="{StaticResource StatusChipStyle}" Padding="7,4" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource BrandTextBrush}" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding LocalPath}" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                                    <TextBlock Text="{Binding RepositorySummary}" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                                    <TextBlock Text="{Binding TrackerSummary}" Margin="0,3,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                                    <TextBlock Text="{Binding UpdatedAtText, StringFormat=Updated {0}}" Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsEditorVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="SELECTED PROJECT" Style="{StaticResource EyebrowTextStyle}" />
                                                <TextBlock Text="Project details" Margin="0,5,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Edit" Command="{Binding EditProjectCommand}" AutomationProperties.Name="Edit selected project" Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>

                                        <StackPanel Visibility="{Binding HasSelectedProject, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,18,0,0">
                                            <TextBlock Text="{Binding SelectedProject.Name}" Style="{StaticResource DisplayTitleStyle}" FontSize="24" TextWrapping="Wrap" />
                                            <Border Style="{StaticResource StatusChipStyle}" HorizontalAlignment="Left" Margin="0,10,0,0">
                                                <TextBlock Text="{Binding SelectedProject.Status}" Foreground="{StaticResource BrandTextBrush}" FontWeight="SemiBold" />
                                            </Border>

                                            <Grid Margin="0,22,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="LOCAL PATH" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedProject.LocalPath}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="1" Text="REPOSITORY PROVIDER" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProject.RepositoryProvider, TargetNullValue=Not configured}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="2" Text="REPOSITORY URL" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProject.RepositoryUrl, TargetNullValue=Not configured}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="3" Text="REPOSITORY ID" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProject.RepositoryId, TargetNullValue=Not configured}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="4" Text="DEFAULT BRANCH" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedProject.DefaultBranch, TargetNullValue=Not configured}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="5" Text="TRACKER TYPE" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedProject.TrackerType, TargetNullValue=Not configured}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="6" Text="TRACKER ID" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedProject.TrackerId, TargetNullValue=Not configured}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="7" Text="GOVERNANCE" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedGovernanceReferencesDisplay}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="8" Text="ROUTING POLICY" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedProject.RoutingPolicyReference, TargetNullValue=Not configured}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="9" Text="SAFETY POLICY" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedProject.SafetyPolicyReference, TargetNullValue=Not configured}" Margin="16,0,0,10" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Grid.Row="10" Text="CREATED / UPDATED" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <StackPanel Grid.Row="10" Grid.Column="1" Margin="16,0,0,10">
                                                    <TextBlock Text="{Binding SelectedCreatedAtText, StringFormat=Created {0}}" Style="{StaticResource BodyTextStyle}" />
                                                    <TextBlock Text="{Binding SelectedUpdatedAtText, StringFormat=Updated {0}}" Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Metadata-only registration. Repository and tracker state is not connected or synchronized here." Margin="0,12,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding HasSelectedProject, Converter={StaticResource InverseBoolToVisibilityConverter}}" Margin="0,22,0,0">
                                            <TextBlock Text="Choose a project" Style="{StaticResource SectionHeadingStyle}" />
                                            <TextBlock Text="Select a registered workspace to inspect its metadata, or use New project to add one." Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="PROJECT REGISTRATION" Style="{StaticResource EyebrowTextStyle}" />
                                                <TextBlock Text="{Binding EditorTitle}" Margin="0,5,0,0" Style="{StaticResource SectionHeadingStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Cancel" Command="{Binding CancelEditCommand}" AutomationProperties.Name="Cancel project edit" Style="{StaticResource GhostButtonStyle}" />
                                                <Button Content="Save changes" Command="{Binding SaveProjectCommand}" AutomationProperties.Name="Save project" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding SavingStateText}" Margin="0,12,0,0" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding ValidationMessage}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrandWarningBrush}" Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding ErrorMessage}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrandErrorBrush}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <Grid Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="NAME" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Project name" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="STATUS" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <ComboBox ItemsSource="{Binding ProjectStatusOptions}" SelectedItem="{Binding EditorStatus}" Style="{StaticResource ProjectInputComboBoxStyle}" AutomationProperties.Name="Project lifecycle status" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                                <TextBlock Text="LOCAL PATH" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorLocalPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Project local path" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                                                <TextBlock Text="REPOSITORY PROVIDER" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorRepositoryProvider, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Repository provider" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                                                <TextBlock Text="REPOSITORY URL" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorRepositoryUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Repository URL" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,12,0,0">
                                                <TextBlock Text="REPOSITORY ID" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorRepositoryId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Repository ID" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,12,0,0">
                                                <TextBlock Text="DEFAULT BRANCH" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorDefaultBranch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Repository default branch" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,12,0,0">
                                                <TextBlock Text="TRACKER TYPE" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorTrackerType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Tracker type" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,12,0,0">
                                                <TextBlock Text="TRACKER ID" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorTrackerId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Tracker ID" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                                <TextBlock Text="GOVERNANCE REFERENCES" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorGovernanceReferencesText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Governance references, one per line" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalScrollBarVisibility="Auto" ToolTip="One reference per line" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,12,0,0">
                                                <TextBlock Text="ROUTING POLICY REFERENCE" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorRoutingPolicyReference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Routing policy reference" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="6" Grid.Column="2" Margin="0,12,0,0">
                                                <TextBlock Text="SAFETY POLICY REFERENCE" Style="{StaticResource ProjectFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditorSafetyPolicyReference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectInputTextBoxStyle}" AutomationProperties.Name="Safety policy reference" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Registration stores metadata only. APO does not check the path, Git, tracker authentication, or repository connectivity in this workspace." Margin="0,18,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.24" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,18" Background="{StaticResource BrandNavyBlueBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" Padding="7" Background="{StaticResource BrandSurfaceRaisedBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1" CornerRadius="12">
                        <Image Source="/Assets/apo-icon.ico" Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AI PROJECT ORCHESTRATOR" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="Intelligent project &amp; AI execution control" Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource StatusChipStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource BrandTealBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="CAPACITY READY" Margin="8,0,0,0" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="18,22" Background="{StaticResource BrandDeepNavyBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="WORKSPACE" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="Command surfaces" Margin="0,5,0,0" Style="{StaticResource SectionHeadingStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,24,0,0">
                        <Button Tag="{Binding IsOverviewSelected}" Command="{Binding ShowOverviewCommand}" AutomationProperties.Name="Overview" Style="{StaticResource WorkspaceNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="◈" FontSize="17" Foreground="{StaticResource BrandCyanBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Overview" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Tag="{Binding IsProjectsSelected}" Command="{Binding ShowProjectsCommand}" AutomationProperties.Name="Projects" Style="{StaticResource WorkspaceNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="□" FontSize="17" Foreground="{StaticResource BrandVioletBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Projects" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Tag="{Binding IsAiCapacitySelected}" Command="{Binding ShowAiCapacityCommand}" AutomationProperties.Name="AI capacity" Style="{StaticResource WorkspaceNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="▰" FontSize="16" Foreground="{StaticResource BrandCyanBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="AI capacity" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button AutomationProperties.Name="Agents (planned)" IsEnabled="False" Style="{StaticResource NavigationItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="◇" FontSize="17" Foreground="{StaticResource BrandPurpleBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Agents" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="SOON" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button AutomationProperties.Name="Activity (planned)" IsEnabled="False" Style="{StaticResource NavigationItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="≡" FontSize="19" Foreground="{StaticResource BrandTealBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Activity" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="SOON" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="2" Padding="12" Background="{StaticResource BrandNavyBlueBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="SCOPE NOTE" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="Future surfaces stay visibly quiet until their capability is real." Margin="0,7,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding ActiveWorkspace}" />
        </Grid>
    </Grid>
</Window>
