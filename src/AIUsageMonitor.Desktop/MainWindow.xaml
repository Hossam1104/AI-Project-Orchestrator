<Window
    x:Class="AIUsageMonitor.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AI Usage Monitor"
    Width="720"
    Height="420"
    MinWidth="480"
    MinHeight="280"
    WindowStartupLocation="CenterScreen">

    <Grid Background="#FF10131A">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock
                Text="AI Usage Monitor"
                Foreground="#FFF4F7FB"
                FontSize="30"
                FontWeight="SemiBold"
                HorizontalAlignment="Center" />
            <TextBlock
                Margin="0,12,0,0"
                Text="No providers connected yet. Your local workspace is ready."
                Foreground="#FFB5C0D0"
                FontSize="15"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>

</Window>
